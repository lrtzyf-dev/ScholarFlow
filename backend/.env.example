# 留空即自动使用 Mock LLM + 本地哈希向量，全部功能离线可跑
# 百炼（OpenAI 兼容）示例：
# LLM_API_KEY=sk-xxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=dashscope/qwen-flash
#
# EMBEDDING_API_KEY=sk-xxxxxxxx
# EMBEDDING_MODEL=text-embedding-v4
#
# 启动 docker compose 后填：
# REDIS_URL=redis://localhost:6379/0

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=dashscope/qwen-flash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
REDIS_URL=
MAX_AGENT_STEPS=6
RETRIEVE_TOPK=6
