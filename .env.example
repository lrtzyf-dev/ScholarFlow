# 研序 ScholarFlow 环境变量模板
# 留空时自动使用离线 Mock LLM + 本地确定性向量，便于评审快速启动。

# 数据目录；桌面 EXE 默认使用 %APPDATA%\\ScholarFlow
DATA_DIR=

# OpenAI 兼容模型（可选；不配置时使用 Mock 模式）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=dashscope/qwen-flash

# Embedding 服务（可选；不配置时使用本地哈希向量）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# 可选 Redis；不配置时任务在本地同步降级执行
REDIS_URL=

# Agent 与检索参数
MAX_AGENT_STEPS=6
RETRIEVE_TOPK=6

# 安全说明：API Key 只写入本地环境变量或应用设置，不提交到公开仓库。
