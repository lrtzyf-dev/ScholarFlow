{
  "name": "scholarflow-frontend",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:markdown": "node --experimental-strip-types --test tests/markdown.test.mjs"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^1.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.7.7",
    "cytoscape": "^3.30.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.8.4",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^4.7.76",
    "vue": "^3.5.10",
    "vue-router": "^4.4.5"
  },
  "lint-staged": {
    "*.{ts,vue,js,cjs,mjs}": [
      "node node_modules/eslint/bin/eslint.js --fix",
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{json,md,css}": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vue-tsc": "^3.3.14"
  }
}
